# OMC HUD/state leakage (OMC hooks write here when a session runs in this repo)
.omc/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# .hq unified store: work/ is regenerable output, runtime/ is session state,
# locks, logs, and anything sensitive. community/ and config/ stay tracked
# (store-spec §3, §5). The `**/` prefix is required because anchors nest.
# Legacy `.omx/` fallback removed this release (store-spec §7 stage 2,
# §9.4 policy-shift) — `.omx/config/`, `.omx/community/`-equivalent content
# is no longer exempt from tracking here.
**/.hq/work/
**/.hq/runtime/
